rules_version = '2';

// ═════════════════════════════════════════════════════════════════════════
//  TIEMPOS — firestore.rules (tiempos-71d42)  ·  v7, 30-sep-2026
//  v2: el agente edita tareas comunes y sesiones, con historial.
//  v3: la agenda de cada uno, lo cotidiano, los chicos y sus actividades
//      (`agendas`, `dias`, `turnos`, `eventos`, `familia`).
//  v4: los acuerdos de tiempo (`bloques`), la plata (`movimientos`,
//      `recurrentes`), lo que propone el agente (`propuestas`) y sus
//      observaciones (`auditoria`).
//  v6: el agente puede leer una tarea que todavía NO existe (para guardar
//      su copia de «antes» en `_historial` antes de crearla).
//  v5: el globo 💡 — una sugerencia o una falla, a `reportes` (el mismo
//      circuito de los sitios: la ronda diaria los lleva al panel).
//  v7: las MARCAS de tiempo (`marcas`): de quién, qué clase y de cuándo a
//      cuándo, sin título, para el balance. Las pone la agenda o cualquiera
//      de los dos («salió Florencia», «salimos juntos»).
//
//  Deny por defecto, SIN catch-all: lo que no está declarado, se niega.
//  Las reglas se SUMAN: este archivo se edita completo, nunca por partes.
//
//  QUIÉN ENTRA
//  · Una persona es MIEMBRO si existe `miembros/{su uid}` con rol 'persona'.
//    Esos documentos los crea el agente al aprobar una solicitud; nadie se
//    hace miembro solo.
//  · El agente se reconoce por su UID, que no se puede elegir. Lee lo común
//    y las horas, escribe `miembros/` y NADA más.
//
//  Por qué NO hay mails en este archivo: el repositorio es público. Por qué
//  no se reconoce a Mauro y Florencia por mail: Firebase deja que
//  cualquiera se registre con cualquier mail, así que «quien tenga tal mail»
//  es «quien lo registre primero».
//
//  LO PERSONAL
//  · Una tarea 'personal' la ve sólo su dueño. Ni el otro ni el agente.
//  · Las sesiones las ven los dos —hacen falta para los totales y el
//    reparto—, así que una sesión de una tarea personal NO lleva el título
//    (lo omite la app; ver app.js).
// ═════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function esAgente() {
      return logueado() && request.auth.uid == 'UID-DEL-AGENTE';
    }
    function miembro() {
      return get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data;
    }
    function esPersona() {
      return logueado()
        && exists(/databases/$(database)/documents/miembros/$(request.auth.uid))
        && miembro().rol == 'persona';
    }
    function tipoValido(t) {
      return t in ['produccion', 'mantenimiento', 'ninos', 'casa', 'personal'];
    }

    // ── Pedir acceso ───────────────────────────────────────────────────
    // Cualquiera con sesión deja UNA solicitud, a su nombre y con el mail
    // de su sesión (no uno inventado). Aprobarla es del agente.
    match /solicitudes/{uid} {
      allow create: if logueado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nombre', 'creadoEn'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40;
      allow read: if (logueado() && request.auth.uid == uid) || esAgente();
    }

    // ── Miembros ───────────────────────────────────────────────────────
    match /miembros/{uid} {
      allow read: if esPersona() || esAgente()
        || (logueado() && request.auth.uid == uid);
      allow create: if esAgente()
        && request.resource.data.rol == 'persona'
        && request.resource.data.keys().hasOnly(['rol', 'nombre', 'email', 'creadoEn']);
      // Cada uno completa en SU ficha la cuenta de Casa Verde que usa, para
      // sumar esas horas. Nada más: ni el rol ni el nombre de otro.
      allow update: if esPersona() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cvUid', 'actualizadoEn']);
    }

    // ── Tareas ─────────────────────────────────────────────────────────
    match /tareas/{id} {
      allow read: if (esPersona()
          && (resource.data.alcance == 'comun' || resource.data.duenio == request.auth.uid))
        // El agente, las comunes. Y una que todavía no existe: su herramienta
        // la lee antes de crearla para guardar la copia de «antes» en el
        // historial, y sin esto no podía crear ninguna (29-sep-2026).
        || (esAgente() && (resource == null || resource.data.alcance == 'comun'));
      allow create: if esPersona()
        && request.resource.data.duenio == request.auth.uid
        && request.resource.data.alcance in ['comun', 'personal']
        && tipoValido(request.resource.data.tipo)
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120;
      // Una común la puede tocar cualquiera de los dos; una personal, su
      // dueño. Nadie cambia de quién es.
      allow update: if esPersona()
        && (resource.data.alcance == 'comun' || resource.data.duenio == request.auth.uid)
        && request.resource.data.duenio == resource.data.duenio
        && request.resource.data.alcance in ['comun', 'personal']
        && tipoValido(request.resource.data.tipo);
      allow delete: if esPersona() && resource.data.duenio == request.auth.uid;
    }

    // ── El agente edita (29-sep-2026, pedido de Mauro: «gestionar y
    //    editar todo, teniendo respaldos») ───────────────────────────────
    // Tareas comunes y sesiones, y cada cambio deja antes su copia en
    // '_historial' (la guarda la herramienta del agente; sin copia no hay
    // cambio). Lo PERSONAL de cada uno sigue fuera de su alcance: es de
    // Florencia y de Mauro, y abrirlo lo deciden los dos.
    match /tareas/{id} {
      allow create: if esAgente() && request.resource.data.alcance == 'comun'
        && tipoValido(request.resource.data.tipo);
      allow update: if esAgente() && resource.data.alcance == 'comun'
        && request.resource.data.alcance == 'comun'
        && tipoValido(request.resource.data.tipo);
      allow delete: if esAgente() && resource.data.alcance == 'comun';
    }
    match /sesiones/{id} {
      allow create, update: if esAgente() && tipoValido(request.resource.data.tipo);
      allow delete: if esAgente();
    }
    match /_historial/{id} {
      allow read: if esAgente() || esPersona();
      allow create: if esAgente();
    }

    // ── Sesiones del cronómetro ────────────────────────────────────────
    // Cada uno escribe SÓLO las suyas: nadie carga horas a nombre del otro.
    match /sesiones/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if esPersona()
        && request.resource.data.uid == request.auth.uid
        && tipoValido(request.resource.data.tipo);
      allow update: if esPersona()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && tipoValido(request.resource.data.tipo);
      allow delete: if esPersona() && resource.data.uid == request.auth.uid;
    }

    // ── v3 · Mi agenda ─────────────────────────────────────────────────
    // Cómo ordena cada uno SU semana. Es de su dueño y de nadie más: mover
    // algo al jueves no le cambia nada al otro.
    match /agendas/{uid} {
      allow read, write: if esPersona() && request.auth.uid == uid;
    }

    // ── v3 · Lo de la casa que ven los dos ─────────────────────────────
    // Lo cotidiano de cada día, los chicos por día (acordado y cambiado) y
    // las actividades con los chicos. Todo lo ven y lo tocan los dos: son
    // de la familia, no de uno. El agente lee y edita con historial.
    match /dias/{fecha} {
      allow read: if esPersona() || esAgente();
      allow create, update: if (esPersona() || esAgente()) && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /turnos/{fecha} {
      allow read: if esPersona() || esAgente();
      allow create, update, delete: if (esPersona() || esAgente()) && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /eventos/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if (esPersona() || esAgente())
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 120
        && request.resource.data.fecha is string;
      allow update: if (esPersona() || esAgente()) && request.resource.data.titulo is string;
      allow delete: if esPersona() || esAgente();
    }
    // `familia/config`: los chicos (nombres y colores) y el patrón acordado
    // de la semana. Los nombres viven en la base y no en el código: el
    // repositorio es público.
    match /familia/{doc} {
      allow read, create, update: if esPersona() || esAgente();
    }

    // ── v7 · Las marcas de tiempo ───────────────────────────────────────
    // Lo único que el balance necesita de un rato: de quién (`uid`, o '*' si
    // es de los dos), qué clase y de cuándo a cuándo. `hasOnly` es lo que
    // garantiza que NO viaje el título de una actividad de la agenda: el otro
    // no tiene por qué verla. Cualquiera marca a nombre de cualquiera («yo
    // puedo avisar la salida del otro»), y la borra quien la puso o de quien
    // es («no salí»). No se editan: se borra y se vuelve a marcar.
    match /marcas/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if esPersona()
        && request.resource.data.marcadoPor == request.auth.uid
        && request.resource.data.clase in ['productivo', 'chicos', 'libre', 'neutro']
        && request.resource.data.desde is string && request.resource.data.hasta is string
        && request.resource.data.keys().hasOnly(['uid', 'clase', 'desde', 'hasta', 'origen', 'marcadoPor', 'nota', 'creadoEn']);
      allow delete: if esPersona()
        && (resource.data.marcadoPor == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // ── v4 · Los acuerdos de tiempo ─────────────────────────────────────
    // «Semana de trabajo afuera», «me quedo con los dos». Los carga
    // cualquiera de los dos, a nombre de cualquiera: por eso cuentan recién
    // cuando LOS DOS confirman que se cumplió. Cada uno confirma SÓLO lo
    // suyo: nadie firma por el otro. Editar el acuerdo borra las firmas.
    match /bloques/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if (esPersona() || esAgente())
        && request.resource.data.clase in ['productivo', 'chicos', 'libre']
        && request.resource.data.desde is string && request.resource.data.hasta is string
        && request.resource.data.confirmaciones.size() == 0;
      allow update: if esPersona() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmaciones', 'actualizadoEn'])
           && request.resource.data.confirmaciones.diff(resource.data.confirmaciones).affectedKeys()
                .hasOnly([request.auth.uid]))
        || (resource.data.creadoPor == request.auth.uid
           && request.resource.data.creadoPor == request.auth.uid
           && request.resource.data.clase in ['productivo', 'chicos', 'libre']
           && request.resource.data.confirmaciones.size() == 0));
      allow delete: if esPersona() && resource.data.creadoPor == request.auth.uid;
    }

    // ── v4 · La plata ──────────────────────────────────────────────────
    // La cargan y la corrigen los dos: es de la familia. El agente la LEE
    // para ayudar a que sea consistente, y lo que quiere agregar o corregir
    // lo PROPONE (abajo): no escribe un gasto sin que una persona lo apruebe.
    match /movimientos/{id} {
      allow read: if esPersona() || esAgente();
      allow create, update: if esPersona()
        && request.resource.data.monto is number && request.resource.data.monto > 0
        && request.resource.data.moneda in ['BRL', 'UYU', 'USD']
        && request.resource.data.categoria is string
        && request.resource.data.fecha is string;
      allow delete: if esPersona();
    }
    match /recurrentes/{id} {
      allow read: if esPersona() || esAgente();
      allow create, update, delete: if esPersona();
    }

    // ── v4 · Lo que propone el agente ──────────────────────────────────
    // Un gasto leído de un chat, una tarea, una actividad. El agente la
    // crea; una persona la aprueba (y la app escribe el documento de verdad)
    // o la descarta. Nadie reescribe lo que el agente propuso: se decide.
    match /propuestas/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if esAgente() && request.resource.data.estado == 'pendiente';
      allow update: if esPersona()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'decididoPor', 'decididoEn', 'resultadoId'])
        && request.resource.data.estado in ['aprobada', 'descartada'];
    }

    // ── v4 · La auditoría ──────────────────────────────────────────────
    // Observaciones del agente sobre cómo se vienen haciendo los registros.
    // Cada uno puede contestar y marcar que la vio; el texto no se toca.
    match /auditoria/{id} {
      allow read: if esPersona() || esAgente();
      allow create: if esAgente();
      allow update: if esPersona()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas', 'vistoPor']);
    }

    // ── v5 · Sugerencias y fallas (el globo 💡) ────────────────────────
    // Lo escribe cualquiera de los dos, a su nombre y en estado 'nuevo'; lo
    // lee el agente en la ronda y lo pasa al panel. Cada uno ve lo suyo, para
    // saber que llegó. El agente no lo escribe: lo que ya trajo se sabe por
    // el `origen` del pendiente en el panel, como en los sitios.
    match /reportes/{id} {
      allow create: if esPersona()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.tipo in ['pedido', 'falla']
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 2000;
      allow read: if esAgente() || (esPersona() && resource.data.uid == request.auth.uid);
    }
  }
}
